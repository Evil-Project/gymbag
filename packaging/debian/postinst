#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if command -v setcap >/dev/null 2>&1; then
        setcap 'cap_net_bind_service=+ep' /usr/bin/gymbag 2>/dev/null || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    echo "==> Gymbag installed!"
    echo "    1. Generate or edit your config:"
    echo "         sudo gymbag init -o /etc/gymbag/Gymbagfile"
    echo "    2. Enable and start the systemd service:"
    echo "         sudo systemctl enable --now gymbag"
fi

exit 0
